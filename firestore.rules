rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- 3-Tier RBAC Helpers (Always require email_verified == true) ---
    function isBootstrapSuperAdmin() {
      return isVerifiedUser()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'jrenghaha2@gmail.com';
    }

    function hasStoredRole(allowedRoles) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in allowedRoles;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || hasStoredRole(['superadmin']);
    }

    function isAdminOrAbove() {
      return isSuperAdmin() || hasStoredRole(['admin', 'superadmin']);
    }

    function isTargetBootstrapSuperAdmin(targetData) {
      return 'email' in targetData
        && targetData.email is string
        && targetData.email.lower() == 'jrenghaha2@gmail.com';
    }

    function isValidRoleValue(val) {
      return val is string && val in ['user', 'admin', 'superadmin'];
    }

    function isValidKanjiId(val) {
      return val is string
        && val.size() >= 2
        && val.size() <= 4
        && val.matches('^n([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$');
    }

    // Full-array validation without loops via uniqueness (toSet) + dual-separator join (',' and '|')
    function isValidKanjiList(arr) {
      return arr is list
        && arr.size() <= 500
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            isValidKanjiId(arr[0])
            && arr.join(',').size() <= 2500
            && arr.join(',').matches('^n([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)(,n([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500))*$')
            && arr.join('|').matches('^n([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)(\\|n([1-9]|[1-9][0-9]|[1-4][0-9]{2}|500))*$')
          )
        );
    }

    function isValidIrodoriBookId(bookId) {
      return bookId is string && bookId in ['pemula', 'dasar1', 'dasar2'];
    }

    function isValidQuizDatasetId(datasetId) {
      return datasetId is string && datasetId in ['n4', 'pemula', 'dasar1', 'dasar2'];
    }

    function isValidOptionalQuizDatasetId(datasetId) {
      return datasetId is string && datasetId in ['', 'n4', 'pemula', 'dasar1', 'dasar2'];
    }

    function isValidOptionalQuizMode(mode) {
      return mode is string && mode in ['', 'random', 'random5', 'k2r', 'k2m', 'm2k', 'r2k', 'ex2k'];
    }

    function isValidQuizCurrentToken(val) {
      return val is string
        && val.size() <= 120
        && val.matches('^(|[1-9][0-9]{0,2}\\|(k2r|k2m|m2k|r2k|ex2k)\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}(,(n|irp|ir|ir2_)[1-9][0-9]{0,3}){0,3}\\|(-1|[0-3]))$');
    }

    function isValidQuizLiveLog(val) {
      return val is string
        && val.size() <= 15000
        && val.matches('^(|[1-9][0-9]{0,2}\\|(k2r|k2m|m2k|r2k|ex2k)\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}(,(n|irp|ir|ir2_)[1-9][0-9]{0,3}){0,3}\\|[0-3](;[1-9][0-9]{0,2}\\|(k2r|k2m|m2k|r2k|ex2k)\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}\\|(n|irp|ir|ir2_)[1-9][0-9]{0,3}(,(n|irp|ir|ir2_)[1-9][0-9]{0,3}){0,3}\\|[0-3])*)$');
    }

    function isValidIrodoriPemulaList(arr) {
      return arr is list
        && arr.size() <= 1136
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^irp([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-9]{2}|11[0-2][0-9]|113[0-6])$')
            && arr.join(',').size() <= 9500
            && arr.join(',').matches('^irp([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-9]{2}|11[0-2][0-9]|113[0-6])(,irp([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-9]{2}|11[0-2][0-9]|113[0-6]))*$')
            && arr.join('|').matches('^irp([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-9]{2}|11[0-2][0-9]|113[0-6])(\\|irp([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-9]{2}|11[0-2][0-9]|113[0-6]))*$')
          )
        );
    }

    function isValidIrodoriDasar1List(arr) {
      return arr is list
        && arr.size() <= 1067
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^ir([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-5][0-9]|106[0-7])$')
            && arr.join(',').size() <= 8000
            && arr.join(',').matches('^ir([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-5][0-9]|106[0-7])(,ir([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-5][0-9]|106[0-7]))*$')
            && arr.join('|').matches('^ir([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-5][0-9]|106[0-7])(\\|ir([1-9]|[1-9][0-9]|[1-9][0-9]{2}|10[0-5][0-9]|106[0-7]))*$')
          )
        );
    }

    function isValidIrodoriDasar2List(arr) {
      return arr is list
        && arr.size() <= 1288
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^ir2_([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-1][0-9]{2}|12[0-7][0-9]|128[0-8])$')
            && arr.join(',').size() <= 12000
            && arr.join(',').matches('^ir2_([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-1][0-9]{2}|12[0-7][0-9]|128[0-8])(,ir2_([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-1][0-9]{2}|12[0-7][0-9]|128[0-8]))*$')
            && arr.join('|').matches('^ir2_([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-1][0-9]{2}|12[0-7][0-9]|128[0-8])(\\|ir2_([1-9]|[1-9][0-9]|[1-9][0-9]{2}|1[0-1][0-9]{2}|12[0-7][0-9]|128[0-8]))*$')
          )
        );
    }

    function isValidIrodoriList(arr, bookId) {
      return (bookId == 'pemula' && isValidIrodoriPemulaList(arr))
        || (bookId == 'dasar1' && isValidIrodoriDasar1List(arr))
        || (bookId == 'dasar2' && isValidIrodoriDasar2List(arr));
    }

    function isValidQuizSessionToken(val) {
      return val is string
        && val.size() >= 25
        && val.size() <= 12000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(all|easy|medium|hard)\\|(random|random5|k2r|k2m|m2k|r2k|ex2k)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(|all|[1-9][0-9]?(\\.[1-9][0-9]?)*)\\|(|[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?(;[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?)*)$');
    }

    function isValidQuizHistorySessions(arr) {
      return arr is list
        && arr.size() <= 15
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            isValidQuizSessionToken(arr[0])
            && arr.join(',').size() <= 160000
            && arr.join(',').matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(all|easy|medium|hard)\\|(random|random5|k2r|k2m|m2k|r2k|ex2k)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(|all|[1-9][0-9]?(\\.[1-9][0-9]?)*)\\|(|[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?(;[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?)*)(,[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(all|easy|medium|hard)\\|(random|random5|k2r|k2m|m2k|r2k|ex2k)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(|all|[1-9][0-9]?(\\.[1-9][0-9]?)*)\\|(|[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?(;[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?)*))*$')
            && arr.join('~').matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(all|easy|medium|hard)\\|(random|random5|k2r|k2m|m2k|r2k|ex2k)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(|all|[1-9][0-9]?(\\.[1-9][0-9]?)*)\\|(|[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?(;[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?)*)(~[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(all|easy|medium|hard)\\|(random|random5|k2r|k2m|m2k|r2k|ex2k)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(|all|[1-9][0-9]?(\\.[1-9][0-9]?)*)\\|(|[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?(;[1-9][0-9]{0,2}:[0-9]:(n|irp|ir|ir2_)[1-9][0-9]{0,3}(:(n|irp|ir|ir2_)[1-9][0-9]{0,3})?)*))*$')
          )
        );
    }

    function isValidDisplayNameField(val) {
      return val is string && val.size() <= 60;
    }

    function isValidEmailField(val) {
      return val is string && val.size() <= 160;
    }

    function isValidAvatarUrlValue(val) {
      return val is string
        && val.size() <= 20000
        && (val.size() == 0
          || val.matches('^https://.*')
          || val.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    function isValidDisplayName(data) {
      return !('displayName' in data) || isValidDisplayNameField(data.displayName);
    }

    function isValidEmail(data) {
      return !('email' in data) || isValidEmailField(data.email);
    }

    function isValidAvatarUrl(data) {
      return !('avatarUrl' in data) || isValidAvatarUrlValue(data.avatarUrl);
    }

    function isValidOptionalRole(data) {
      return !('role' in data) || isValidRoleValue(data.role);
    }

    function isOwnerEmailMatch(data) {
      return !('email' in data)
        || data.email == ''
        || (
          'email' in request.auth.token
          && request.auth.token.email is string
          && data.email.lower() == request.auth.token.email.lower()
        );
    }

    // Standalone Validation Blueprint for UserProgress (safe for both create and update, including Superadmin role updates)
    function isValidUserProgress(data, userId) {
      return data.keys().hasAll(['uid', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mastered', 'hard', 'displayName', 'email', 'avatarUrl', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && isValidKanjiList(data.mastered)
        && isValidKanjiList(data.hard)
        && data.mastered.toSet().intersection(data.hard.toSet()).size() == 0
        && isValidDisplayName(data)
        && isValidEmail(data)
        && isValidAvatarUrl(data)
        && isValidOptionalRole(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for IrodoriBookProgress (safe for both create and update)
    function isValidIrodoriProgress(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidIrodoriBookId(data.bookId)
        && data.bookId == bookId
        && isValidIrodoriList(data.mastered, bookId)
        && isValidIrodoriList(data.hard, bookId)
        && data.mastered.toSet().intersection(data.hard.toSet()).size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for QuizHistoryBucket (safe for both create and update)
    function isValidQuizHistoryBucket(data, datasetId) {
      return data.keys().hasAll(['uid', 'datasetId', 'sessions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'datasetId', 'sessions', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidQuizDatasetId(data.datasetId)
        && data.datasetId == datasetId
        && isValidQuizHistorySessions(data.sessions)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for LiveActivity
    function isValidLiveActivity(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'avatarUrl', 'role',
          'activityType', 'datasetMode', 'datasetId', 'moduleLabel', 'scopeLabel',
          'quizInProgress', 'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount', 'quizMode',
          'totalMastered', 'totalHard', 'n4Mastered', 'irodoriMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizTotal', 'lastQuizDatasetId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'avatarUrl', 'role',
          'activityType', 'datasetMode', 'datasetId', 'moduleLabel', 'scopeLabel',
          'quizInProgress', 'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount', 'quizMode',
          'quizCurrentToken', 'quizLiveLog',
          'totalMastered', 'totalHard', 'n4Mastered', 'irodoriMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizTotal', 'lastQuizDatasetId', 'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidDisplayNameField(data.displayName)
        && isValidEmailField(data.email)
        && isOwnerEmailMatch(data)
        && isValidAvatarUrlValue(data.avatarUrl)
        && isValidRoleValue(data.role)
        && data.activityType is string
        && data.activityType in ['browsing', 'flashcard', 'list', 'quiz_setup', 'quiz_running', 'quiz_result', 'admin_panel']
        && data.datasetMode is string
        && data.datasetMode in ['n4', 'irodori']
        && isValidQuizDatasetId(data.datasetId)
        && data.moduleLabel is string && data.moduleLabel.size() <= 120
        && data.scopeLabel is string && data.scopeLabel.size() <= 120
        && data.quizInProgress is bool
        && data.quizCurrentQuestion is int && data.quizCurrentQuestion >= 0 && data.quizCurrentQuestion <= 500
        && data.quizTotalQuestions is int && data.quizTotalQuestions >= 0 && data.quizTotalQuestions <= 500
        && data.quizCorrectCount is int && data.quizCorrectCount >= 0 && data.quizCorrectCount <= 500
        && isValidOptionalQuizMode(data.quizMode)
        && (!('quizCurrentToken' in data) || isValidQuizCurrentToken(data.quizCurrentToken))
        && (!('quizLiveLog' in data) || isValidQuizLiveLog(data.quizLiveLog))
        && data.totalMastered is int && data.totalMastered >= 0 && data.totalMastered <= 5000
        && data.totalHard is int && data.totalHard >= 0 && data.totalHard <= 5000
        && data.n4Mastered is int && data.n4Mastered >= 0 && data.n4Mastered <= 500
        && data.irodoriMastered is int && data.irodoriMastered >= 0 && data.irodoriMastered <= 4000
        && data.totalQuizSessions is int && data.totalQuizSessions >= 0 && data.totalQuizSessions <= 5000
        && data.lastQuizScore is int && data.lastQuizScore >= -1 && data.lastQuizScore <= 100
        && data.lastQuizTotal is int && data.lastQuizTotal >= 0 && data.lastQuizTotal <= 500
        && isValidOptionalQuizDatasetId(data.lastQuizDatasetId)
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for ActivityEvent (immutable append-only)
    function isValidActivityEvent(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'avatarUrl', 'eventType',
          'datasetId', 'moduleLabel', 'scopeLabel', 'quizMode',
          'score', 'correct', 'total', 'totalMastered', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'avatarUrl', 'eventType',
          'datasetId', 'moduleLabel', 'scopeLabel', 'quizMode',
          'score', 'correct', 'total', 'totalMastered', 'summary', 'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidDisplayNameField(data.displayName)
        && isValidEmailField(data.email)
        && isOwnerEmailMatch(data)
        && isValidAvatarUrlValue(data.avatarUrl)
        && data.eventType is string
        && data.eventType in ['quiz_started', 'quiz_completed', 'progress_milestone']
        && isValidQuizDatasetId(data.datasetId)
        && data.moduleLabel is string && data.moduleLabel.size() <= 120
        && data.scopeLabel is string && data.scopeLabel.size() <= 120
        && isValidOptionalQuizMode(data.quizMode)
        && data.score is int && data.score >= -1 && data.score <= 100
        && data.correct is int && data.correct >= 0 && data.correct <= 500
        && data.total is int && data.total >= 0 && data.total <= 500
        && data.totalMastered is int && data.totalMastered >= 0 && data.totalMastered <= 5000
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
        && data.createdAt is timestamp;
    }

    function isSafeOwnerRoleOnCreate(data) {
      return !('role' in data)
        || data.role == 'user'
        || (isBootstrapSuperAdmin() && data.role == 'superadmin');
    }

    function isSafeOwnerRoleOnUpdate(inc, ex) {
      return !('role' in inc.diff(ex).affectedKeys())
        || (
          !('role' in ex)
          && (inc.role == 'user' || (isBootstrapSuperAdmin() && inc.role == 'superadmin'))
        )
        || (
          isBootstrapSuperAdmin() && inc.role == 'superadmin'
        );
    }

    // --- /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrAbove());

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && isSafeOwnerRoleOnCreate(incoming())
        && isOwnerEmailMatch(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1..4: Verified owner updates own progress/profile/auto-heal metadata (cannot escalate role)
          (
            isOwner(userId)
            && isOwnerEmailMatch(incoming())
            && isSafeOwnerRoleOnUpdate(incoming(), existing())
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'displayName', 'avatarUrl', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'email', 'role', 'mastered', 'hard', 'updatedAt'])
            )
          ) ||
          // Action 5: Superadmin manages role of another user (cannot modify self or Bootstrap Superadmin)
          (
            userId != request.auth.uid
            && isSuperAdmin()
            && !isTargetBootstrapSuperAdmin(existing())
            && 'role' in incoming()
            && isValidRoleValue(incoming().role)
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && !isTargetBootstrapSuperAdmin(existing());

      // --- /users/{userId}/irodoriProgress/{bookId} ---
      match /irodoriProgress/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidIrodoriBookId(bookId)
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && isValidId(userId)
          && isAdminOrAbove();

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidIrodoriBookId(bookId)
          && isValidIrodoriProgress(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidIrodoriBookId(bookId)
          && isValidIrodoriProgress(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidIrodoriBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // --- /users/{userId}/quizHistory/{datasetId} ---
      match /quizHistory/{datasetId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidQuizDatasetId(datasetId)
          && (isOwner(userId) || isAdminOrAbove())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && isValidId(userId)
          && isAdminOrAbove();

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidQuizDatasetId(datasetId)
          && isValidQuizHistoryBucket(incoming(), datasetId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidQuizDatasetId(datasetId)
          && isValidQuizHistoryBucket(incoming(), datasetId)
          && incoming().uid == existing().uid
          && incoming().datasetId == existing().datasetId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['sessions', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidQuizDatasetId(datasetId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // --- /liveActivity/{userId} ---
    match /liveActivity/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrAbove());

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId));

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'avatarUrl', 'role',
          'activityType', 'datasetMode', 'datasetId', 'moduleLabel', 'scopeLabel',
          'quizInProgress', 'quizCurrentQuestion', 'quizTotalQuestions', 'quizCorrectCount', 'quizMode',
          'quizCurrentToken', 'quizLiveLog',
          'totalMastered', 'totalHard', 'n4Mastered', 'irodoriMastered',
          'totalQuizSessions', 'lastQuizScore', 'lastQuizTotal', 'lastQuizDatasetId', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);
    }

    // --- /activityEvents/{eventId} ---
    match /activityEvents/{eventId} {
      allow get: if isSignedIn()
        && isValidId(eventId)
        && (isAdminOrAbove() || existing().uid == request.auth.uid);

      allow list: if isAdminOrAbove();

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(eventId)
        && isValidActivityEvent(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update, delete: if false;
    }
  }
}
